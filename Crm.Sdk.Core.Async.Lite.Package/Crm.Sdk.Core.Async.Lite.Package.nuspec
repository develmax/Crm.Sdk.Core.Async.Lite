    <id>Crm.Sdk.Core.Lite</id>
    <version>11.0.0</version>
    <authors>Maksim Moiseev</authors>
    <license type="file">licenses/license.txt</license>
    <icon>images/icon.png</icon>
    <readme>README.md</readme>
    <description>Async SDK for Microsoft Dynamics CRM on-premises with pooled NTLM authentication. .NET Core 2.1 through .NET 10.</description>
    <releaseNotes>Reuse authenticated transport pools; local cancellation and timeout safety; .NET Standard 2.0 and .NET 6-10 assets. See README for migration and runtime requirements.</releaseNotes>
    <tags>dynamics crm sdk core async ntlm</tags>
    <repository type="git" url="https://github.com/develmax/Crm.Sdk.Core.Async.Lite.git" />
    <projectUrl>https://github.com/develmax/Crm.Sdk.Core.Async.Lite</projectUrl>
